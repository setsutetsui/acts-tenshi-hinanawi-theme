{
	"name": "Tenshi Hinanawi",
	"type": "dark",
	"colors": {
		// Workbench Base (Obsidian Plum #19141a)
		"editor.background": "#19141a",
		"editor.foreground": "#feecd5",
		"activityBar.background": "#141015",
		"activityBar.foreground": "#ff98bf",
		"sideBar.background": "#161217",
		"sideBar.foreground": "#99c9dc",
		"sideBarSectionHeader.background": "#1e1820",
		"sideBarSectionHeader.foreground": "#feecd5",
		// Borders, Cursor & Selections
		"focusBorder": "#ff98bf",
		"editorCursor.foreground": "#fa343b",
		"editor.selectionBackground": "#1476f444",
		"editor.lineHighlightBackground": "#221b24",
		"editorLineNumber.foreground": "#413343",
		"editorLineNumber.activeForeground": "#ffd47d",
		// Tabs & Title Bar
		"tab.activeBackground": "#19141a",
		"tab.activeForeground": "#ffffef",
		"tab.activeBorderTop": "#fa343b",
		"tab.inactiveBackground": "#141015",
		"tab.inactiveForeground": "#72a8bb",
		"titleBar.activeBackground": "#141015",
		"titleBar.activeForeground": "#feecd5",
		// Status Bar
		"statusBar.background": "#120e13",
		"statusBar.foreground": "#99c9dc",
		"statusBarItem.remoteBackground": "#1476f4",
		// Bracket Pair Rainbow (Tenshi Apron Sequence starting from Green)
		"editorBracketHighlight.foreground1": "#69bd2d",
		"editorBracketHighlight.foreground2": "#72a8bb",
		"editorBracketHighlight.foreground3": "#9bc0ff",
		"editorBracketHighlight.foreground4": "#ff98bf",
		"editorBracketHighlight.foreground5": "#ffd47d",
		"editorBracketHighlight.foreground6": "#fa343b",
		"editorBracketPairGuide.activeBackground1": "#69bd2d66",
		"editorBracketPairGuide.activeBackground2": "#72a8bb66",
		"editorBracketPairGuide.activeBackground3": "#9bc0ff66",
		"editorBracketPairGuide.activeBackground4": "#ff98bf66",
		"editorBracketPairGuide.activeBackground5": "#ffd47d66",
		"editorBracketPairGuide.activeBackground6": "#fa343b66",
		"editorBracketMatch.border": "#ffffef",
		// Integrated Terminal (Direct Kitty ANSI Mirror)
		"terminal.background": "#19141a",
		"terminal.foreground": "#feecd5",
		"terminalCursor.foreground": "#fa343b",
		"terminal.ansiBlack": "#19141a",
		"terminal.ansiRed": "#fa343b",
		"terminal.ansiGreen": "#69bd2d",
		"terminal.ansiYellow": "#ffdd20",
		"terminal.ansiBlue": "#1476f4",
		"terminal.ansiMagenta": "#ff98bf",
		"terminal.ansiCyan": "#72a8bb",
		"terminal.ansiWhite": "#feecd5",
		"terminal.ansiBrightBlack": "#413343",
		"terminal.ansiBrightRed": "#f06f66",
		"terminal.ansiBrightGreen": "#a3e39f",
		"terminal.ansiBrightYellow": "#ffd47d",
		"terminal.ansiBrightBlue": "#9bc0ff",
		"terminal.ansiBrightMagenta": "#ffb8d3",
		"terminal.ansiBrightCyan": "#99c9dc",
		"terminal.ansiBrightWhite": "#ffffef"
	},
	"tokenColors": [
		{
			"name": "Keywords & Declarations (const, let, function, if)",
			"scope": [
				"keyword",
				"keyword.control",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#3a8eff",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Function Declarations",
			"scope": [
				"entity.name.function",
				"entity.name.function.declaration"
			],
			"settings": {
				"foreground": "#9bc0ff",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Object Methods & Member Calls",
			"scope": [
				"meta.function-call.member",
				"meta.method-call",
				"support.function",
				"entity.name.function.member"
			],
			"settings": {
				"foreground": "#ffd47d"
			}
		},
		{
			"name": "Standalone Function Calls",
			"scope": [
				"meta.function-call",
				"meta.function-call.without-args"
			],
			"settings": {
				"foreground": "#ffb8d3"
			}
		},
		{
			"name": "Variables, Object Properties & Identifiers",
			"scope": [
				"variable",
				"variable.other",
				"variable.parameter",
				"variable.other.property",
				"meta.property.object",
				"support.variable",
				"support.class",
				"support.type"
			],
			"settings": {
				"foreground": "#ffffef"
			}
		},
		{
			"name": "Leaf Green - Strings",
			"scope": [
				"string",
				"string.template",
				"string.quoted"
			],
			"settings": {
				"foreground": "#a3e39f"
			}
		},
		{
			"name": "Danmaku Gold - Numbers, Booleans & Operators",
			"scope": [
				"constant.numeric",
				"constant.language.boolean",
				"keyword.operator"
			],
			"settings": {
				"foreground": "#ffdd20"
			}
		},
		{
			"name": "Sword Scarlet - Returns, Flow Control & Null",
			"scope": [
				"keyword.control.flow",
				"keyword.control.return",
				"constant.language.null",
				"constant.language.undefined"
			],
			"settings": {
				"foreground": "#fa343b",
				"fontStyle": "bold italic"
			}
		},
		{
			"name": "Green Parentheses & Parameter Enclosures",
			"scope": [
				"punctuation.definition.parameters",
				"punctuation.definition.arguments",
				"punctuation.definition.group",
				"meta.function-call.arguments punctuation.definition.arguments",
				"meta.function-call punctuation.definition.arguments",
				"meta.function.parameters punctuation.definition.parameters"
			],
			"settings": {
				"foreground": "#69bd2d"
			}
		},
		{
			"name": "Dusky Plum - Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#7a627e",
				"fontStyle": "italic"
			}
		}
	]
}